# libFuzzer dictionary for compress_fuzzer.
# The harness treats input as a raw source buffer; these tokens push the
# mutator toward compressible structures (runs, ramps, float patterns, text)
# so more iterations get past the "cannot compress" early return.
"AAAAAAAAAAAAAAAA"
"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
"\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa"
"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
"\x00\x00\x80\x3f\x00\x00\x80\x3f\x00\x00\x80\x3f\x00\x00\x80\x3f"
"abcdefghijklmnop"
"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
"\xff\xff\xff\xff\xff\xff\xff\xff"
"\x80\x7f\x00\x00\x80\x7f\x00\x00"
